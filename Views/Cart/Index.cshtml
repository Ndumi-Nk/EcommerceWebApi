@model List<Ecommerce.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="mb-4">Shopping Cart</h2>

    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">Your cart is empty.</div>
    }
    else
    {
        <div class="cart-items d-flex flex-column gap-3">

            @foreach (var item in Model)
            {
                <div class="cart-item d-flex align-items-center justify-content-between p-3 shadow-sm rounded-3 bg-white flex-wrap">
                    <div class="d-flex align-items-center gap-3 flex-grow-1">
                        <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : Url.Content("~/images/no-image.png"))"
                             alt="@item.ProductName" class="cart-product-img">

                        <div class="product-info">
                            <h5 class="mb-1 fw-bold">@item.ProductName</h5>
                            <p class="mb-0 text-muted">@item.Price.ToString("C") each</p>
                            <small class="text-secondary">Stock: @item.Stock</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <!-- Decrease -->
                        @using (Html.BeginForm("Decrease", "Cart", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">-</button>
                        }

                        <span class="fw-bold">@item.Quantity</span>

                        <!-- Increase -->
                        @using (Html.BeginForm("Increase", "Cart", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary" @(item.Quantity >= item.Stock ? "disabled" : "")>+</button>
                        }

                        <!-- Item Total -->
                        <div class="item-total fw-bold">
                            @((item.Price * item.Quantity).ToString("C"))
                        </div>

                        <!-- Remove -->
                        @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Cart Summary -->
        <div class="cart-summary mt-4 p-4 bg-light rounded-3 shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h4 class="mb-0">Total: @Model.Sum(x => x.Price * x.Quantity).ToString("C")</h4>
            <div class="d-flex gap-2 flex-wrap">
                @using (Html.BeginForm("Clear", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">Clear Cart</button>
                }
                <a class="btn btn-primary" href="@Url.Action("Index", "Checkout")">Checkout</a>
            </div>
        </div>
    }
</div>

<style>
    .cart-item {
        transition: all 0.2s ease;
        gap: 1rem;
    }

        .cart-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px rgba(0,0,0,0.1);
        }

    .cart-product-img {
        width: 80px;
        height: 80px;
        object-fit: contain;
        border-radius: 8px;
    }

    .quantity-control button {
        width: 30px;
        height: 30px;
        padding: 0;
    }

    .item-total {
        min-width: 70px;
        text-align: right;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }

    .cart-summary button {
        min-width: 120px;
    }

    @@media (max-width: 768px) {
        .cart-item

    {
        flex-direction: column;
        align-items: flex-start;
    }

    .cart-item .item-total,
    .cart-item .quantity-control,
    .cart-item form {
        margin-top: 0.5rem;
    }

    }
</style>
