@model Ecommerce.Models.ProductCreateViewModel

@{
    ViewData["Title"] = "Create Product";
    Layout = "_Layout"; // <- This sets the layout file
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0"><i class="bi bi-box-seam"></i> Create Product</h3>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter product name" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, placeholder = "Enter product description" })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Price, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", placeholder = "0.00" })
                                @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.StockQuantity, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control", type = "number", placeholder = "Available stock" })
                                @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Image, new { @class = "form-label fw-bold" })
                            <input type="file" name="Image" class="form-control" />
                            @Html.ValidationMessageFor(m => m.Image, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save2"></i> Save Product
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
